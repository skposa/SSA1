<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#07050a">
<title>فرقة SSA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cinzel+Decorative:wght@700;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --void:#07050a; --ink:#120b1c; --panel:#1a1027; --line:#3a2457;
  --bone:#ebe3d4; --mute:#9a8fae; --blood:#c0143c; --blood2:#7d0c27; --violet:#6a35c9;
  --ok:#3fbf8f;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%;background:var(--void);color:var(--bone);font-family:'Tajawal',system-ui,sans-serif}
body{min-height:100vh;overflow-x:hidden}
/* ضباب بنفسجي بطيء + حبيبات */
body::before{content:"";position:fixed;inset:-20%;z-index:-2;
  background:radial-gradient(40% 35% at 20% 25%,rgba(106,53,201,.28),transparent 70%),
             radial-gradient(35% 30% at 80% 70%,rgba(192,20,60,.22),transparent 70%),
             radial-gradient(50% 40% at 50% 100%,rgba(60,20,110,.35),transparent 70%);
  animation:drift 22s ease-in-out infinite alternate}
body::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.07;
  background-image:repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 3px)}
@keyframes drift{to{transform:translate(4%,-3%) scale(1.08)}}

.wrap{max-width:460px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 22px) 18px 40px}
.screen{display:none}.screen.on{display:block}

/* الشعار */
.logo{text-align:center;margin:10px 0 26px;user-select:none}
.logo .fr{font-family:'Aref Ruqaa',serif;font-size:30px;color:var(--bone);letter-spacing:.02em;display:block;margin-bottom:-6px;
  text-shadow:0 0 18px rgba(192,20,60,.7)}
.logo .orn{color:var(--blood);font-size:15px;letter-spacing:.6em;opacity:.9;direction:ltr}
.glitch{position:relative;display:inline-block;font-family:'Cinzel Decorative',serif;font-weight:900;font-size:68px;line-height:1.05;
  color:var(--bone);direction:ltr;text-shadow:0 0 28px rgba(106,53,201,.8)}
.glitch::before,.glitch::after{content:attr(data-t);position:absolute;inset:0;overflow:hidden}
.glitch::before{color:var(--blood);transform:translate(-2px,0);clip-path:inset(0 0 55% 0);animation:gl1 4.5s infinite steps(1)}
.glitch::after{color:#6fe3ff;transform:translate(2px,0);clip-path:inset(60% 0 0 0);animation:gl2 4.5s infinite steps(1);mix-blend-mode:screen}
@keyframes gl1{0%,88%,100%{transform:translate(0)}90%{transform:translate(-4px,1px)}94%{transform:translate(3px,-1px)}}
@keyframes gl2{0%,86%,100%{transform:translate(0)}89%{transform:translate(4px,-1px)}93%{transform:translate(-3px,1px)}}

/* لوحات */
.card{background:linear-gradient(180deg,rgba(26,16,39,.92),rgba(18,11,28,.92));border:1px solid var(--line);border-radius:18px;padding:22px;
  box-shadow:0 0 0 1px rgba(0,0,0,.6),0 18px 50px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.04)}
h2{font-family:'Aref Ruqaa',serif;font-weight:700;font-size:26px;margin:0 0 6px}
p.sub{color:var(--mute);margin:0 0 18px;font-size:15px;line-height:1.7}
label{display:block;color:var(--mute);font-size:14px;margin:14px 0 6px}
input{width:100%;background:#0d0716;border:1px solid var(--line);color:var(--bone);border-radius:12px;padding:14px;font:inherit;font-size:17px;outline:none;transition:border-color .2s,box-shadow .2s}
input:focus{border-color:var(--blood);box-shadow:0 0 0 3px rgba(192,20,60,.25)}
input.code{text-align:center;direction:ltr;letter-spacing:.25em;font-size:22px}
button{font:inherit;cursor:pointer;border:0;color:var(--bone)}
button:focus-visible,input:focus-visible{outline:2px solid var(--bone);outline-offset:2px}
.btn{width:100%;margin-top:18px;padding:15px;border-radius:12px;font-weight:700;font-size:17px;
  background:linear-gradient(135deg,var(--blood),var(--blood2));box-shadow:0 8px 24px rgba(192,20,60,.35);transition:transform .15s,filter .15s}
.btn:active{transform:scale(.98)}.btn:disabled{filter:grayscale(.8) brightness(.6);cursor:not-allowed}
.btn.ghost{background:transparent;border:1px solid var(--line);box-shadow:none;color:var(--mute)}
.err{min-height:22px;margin-top:12px;color:#ff6b86;font-size:14px;text-align:center}
.shake{animation:shake .4s}
@keyframes shake{25%{transform:translateX(8px)}75%{transform:translateX(-8px)}}

.tabs{display:flex;gap:6px;background:#0d0716;border:1px solid var(--line);border-radius:12px;padding:4px;margin-bottom:6px}
.tabs button{flex:1;padding:11px;border-radius:9px;background:transparent;color:var(--mute);font-weight:700}
.tabs button.on{background:var(--panel);color:var(--bone);box-shadow:inset 0 0 0 1px var(--line)}

/* الشريط العلوي */
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.who{font-size:15px}.who b{font-size:17px}
.idchip{display:inline-flex;align-items:center;gap:8px;background:#0d0716;border:1px solid var(--line);border-radius:999px;padding:8px 14px;direction:ltr;font-size:17px;letter-spacing:.18em}
.idchip button{background:transparent;color:var(--blood);font-size:14px;letter-spacing:0;font-family:'Tajawal'}
.small{padding:9px 14px;border-radius:10px;background:var(--panel);border:1px solid var(--line);font-size:14px}

/* الميكروفون */
.stage{display:grid;place-items:center;height:210px;position:relative;margin:6px 0 4px}
.ring{position:absolute;width:150px;height:150px;border-radius:50%;border:1px solid var(--blood);opacity:0}
.live .ring{animation:ring 2.4s infinite}.live .ring:nth-child(2){animation-delay:.8s}.live .ring:nth-child(3){animation-delay:1.6s}
@keyframes ring{0%{transform:scale(.8);opacity:.7}100%{transform:scale(1.6);opacity:0}}
.mic{position:relative;width:132px;height:132px;border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 35% 30%,#2a1745,#0d0716 70%);border:2px solid var(--line);transition:border-color .3s,box-shadow .3s}
.live .mic{border-color:var(--blood);box-shadow:0 0 40px rgba(192,20,60,.55),inset 0 0 30px rgba(192,20,60,.25)}
.muted .mic{border-color:#c9a227;box-shadow:0 0 30px rgba(201,162,39,.35)}
.mic svg{width:58px;height:58px;fill:none;stroke:var(--bone);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.meter{height:6px;border-radius:6px;background:#0d0716;border:1px solid var(--line);overflow:hidden;margin:2px 0 14px}
.meter i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--violet),var(--blood));transition:width .08s}
.status{text-align:center;color:var(--mute);font-size:14px;min-height:20px;margin-bottom:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.ctl{padding:14px 6px;border-radius:12px;background:var(--panel);border:1px solid var(--line);font-weight:700;font-size:15px}
.ctl.go{background:linear-gradient(135deg,var(--blood),var(--blood2));border-color:transparent}
.ctl.lock.on{background:#4a3a08;border-color:#c9a227;color:#ffe08a}
.ctl:disabled{opacity:.4}

.fxh{display:flex;justify-content:space-between;align-items:baseline;margin:24px 0 10px}
.fxh h3{margin:0;font-family:'Aref Ruqaa',serif;font-size:22px}
.fxh span{color:var(--mute);font-size:13px}
.fx{display:grid;gap:9px}
.fxb{display:flex;align-items:center;justify-content:space-between;width:100%;padding:15px 16px;border-radius:14px;background:var(--panel);border:1px solid var(--line);text-align:right;transition:all .2s}
.fxb small{display:block;color:var(--mute);font-size:12.5px;margin-top:2px;font-weight:400}
.fxb strong{font-size:17px}
.fxb .dot{width:14px;height:14px;border-radius:50%;background:#2c1d42;border:1px solid var(--line);flex:none}
.fxb.on{border-color:var(--blood);background:linear-gradient(90deg,rgba(192,20,60,.22),var(--panel));box-shadow:0 0 22px rgba(192,20,60,.3)}
.fxb.on .dot{background:var(--blood);box-shadow:0 0 12px var(--blood);border-color:var(--blood)}
.fxb:disabled{opacity:.35;cursor:not-allowed}
.note{margin-top:14px;padding:12px 14px;border-radius:12px;border:1px dashed var(--line);color:var(--mute);font-size:13.5px;line-height:1.7}
.note.warn{border-color:#c9a227;color:#ffe08a}

/* محظور */
.banned{text-align:center}
.banned .big{font-family:'Aref Ruqaa',serif;font-size:34px;color:#ff6b86;margin:6px 0}
.count{direction:ltr;font-size:30px;letter-spacing:.1em;margin:14px 0;font-variant-numeric:tabular-nums}

/* الإدارة */
.pill{display:inline-block;padding:4px 12px;border-radius:999px;font-size:13px;border:1px solid var(--line)}
.pill.ok{color:var(--ok);border-color:var(--ok)}.pill.bad{color:#ff6b86;border-color:#ff6b86}
.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;margin:14px 0;font-size:15px}
.kv dt{color:var(--mute)}.kv dd{margin:0;direction:ltr;text-align:right}
.acts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.acts .ctl.full{grid-column:1/-1}
.acts .danger{background:linear-gradient(135deg,var(--blood),var(--blood2));border-color:transparent}
.acts .good{background:#123a2c;border-color:var(--ok);color:#9cf0cf}
.banbox{display:none;margin-top:12px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#0d0716}
.banbox.on{display:block}
.quick{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
.quick button{padding:8px 12px;border-radius:999px;background:var(--panel);border:1px solid var(--line);font-size:13px}
.recent{margin-top:20px}
.recent button{display:flex;justify-content:space-between;width:100%;padding:12px 14px;margin-top:6px;border-radius:12px;background:var(--panel);border:1px solid var(--line);text-align:right}
.recent .i{direction:ltr;letter-spacing:.12em;color:var(--blood)}

.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom) + 20px);transform:translate(-50%,30px);opacity:0;background:#000;border:1px solid var(--line);padding:12px 18px;border-radius:12px;font-size:15px;transition:all .3s;z-index:9;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">

  <div class="logo" id="logo">
    <span class="fr">فِرْقَةُ</span>
    <span class="glitch" data-t="SSA">SSA</span>
    <div class="orn">✦ ❖ ✦</div>
  </div>

  <!-- 1) بوابة الرمز -->
  <section class="screen" id="s-gate">
    <div class="card">
      <h2>الباب مغلق</h2>
      <p class="sub">أدخل الرمز السري لتفتح الباب.</p>
      <input id="code" class="code" inputmode="decimal" autocomplete="off" placeholder="• • • • • • • • • •">
      <button class="btn" id="gateBtn">فتح</button>
      <div class="err" id="gateErr"></div>
    </div>
  </section>

  <!-- 2) دخول / تسجيل -->
  <section class="screen" id="s-auth">
    <div class="card">
      <div class="tabs">
        <button id="tabLogin" class="on">تسجيل الدخول</button>
        <button id="tabReg">حساب جديد</button>
      </div>
      <label for="u">اسم المستخدم</label>
      <input id="u" autocomplete="username" autocapitalize="none" spellcheck="false">
      <label for="p">كلمة المرور</label>
      <input id="p" type="password" autocomplete="current-password">
      <div id="regOnly" style="display:none">
        <label for="p2">تأكيد كلمة المرور</label>
        <input id="p2" type="password" autocomplete="new-password">
      </div>
      <button class="btn" id="authBtn">دخول</button>
      <div class="err" id="authErr"></div>
    </div>
  </section>

  <!-- 3) التطبيق -->
  <section class="screen" id="s-app">
    <div class="top">
      <div class="who">أهلاً <b id="uname"></b></div>
      <button class="small" id="out1">خروج</button>
    </div>
    <div style="margin-bottom:6px">
      <span class="idchip"><span id="uid"></span><button id="copyId">نسخ</button></span>
    </div>

    <div class="stage" id="stage">
      <div class="ring"></div><div class="ring"></div><div class="ring"></div>
      <div class="mic">
        <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7"/></svg>
      </div>
    </div>
    <div class="meter"><i id="lvl"></i></div>
    <div class="status" id="status">المايك متوقف</div>

    <div class="row3">
      <button class="ctl go" id="bStart">تشغيل المايك</button>
      <button class="ctl lock" id="bMute" disabled>قفل المايك</button>
      <button class="ctl" id="bStop" disabled>إيقاف</button>
    </div>

    <div class="fxh"><h3>المؤثرات</h3><span id="fxState"></span></div>
    <div class="fx" id="fxList">
      <button class="fxb" data-fx="echo"><span><strong>التكرار</strong><small>يعيد صوتك عدة مرات</small></span><i class="dot"></i></button>
      <button class="fxb" data-fx="radio"><span><strong>الترددات اللاسلكية</strong><small>صوت جهاز اتصال قديم</small></span><i class="dot"></i></button>
      <button class="fxb" data-fx="dist"><span><strong>التغويش</strong><small>تشويش وتكسير في الصوت</small></span><i class="dot"></i></button>
      <button class="fxb" data-fx="bass"><span><strong>الباس</strong><small>صوت أعمق وأثقل</small></span><i class="dot"></i></button>
      <button class="fxb" data-fx="loud"><span><strong>صوت عالٍ جداً</strong><small>صدى وتكرار بأعلى قوة</small></span><i class="dot"></i></button>
    </div>
    <div class="note" id="featNote" style="display:none"></div>
    <div class="note">الصوت يخرج من سماعة هاتفك نفسه. لتجنّب الصفير (الارتجاع) استخدم سماعة أذن، أو خفّض صوت الهاتف.</div>
  </section>

  <!-- 4) محظور -->
  <section class="screen" id="s-ban">
    <div class="card banned">
      <div class="big">أنت محظور</div>
      <p class="sub" id="banTxt"></p>
      <div class="count" id="banCount"></div>
      <button class="btn ghost" id="out2">تسجيل الخروج</button>
    </div>
  </section>

  <!-- 5) لوحة الإدارة -->
  <section class="screen" id="s-admin">
    <div class="top">
      <div class="who">لوحة الإدارة · <b id="aname"></b></div>
      <button class="small" id="out3">خروج</button>
    </div>
    <div class="card">
      <label for="sid" style="margin-top:0">ابحث بالـ ID</label>
      <div style="display:flex;gap:8px">
        <input id="sid" class="code" inputmode="numeric" maxlength="5" placeholder="00000" style="letter-spacing:.3em">
        <button class="ctl go" id="sBtn" style="width:90px">بحث</button>
      </div>
      <div class="err" id="sErr"></div>

      <div id="uCard" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <b style="font-size:20px" id="cName"></b>
          <span class="pill" id="cStatus"></span>
        </div>
        <dl class="kv">
          <dt>ID</dt><dd id="cId"></dd>
          <dt>الميزات</dt><dd id="cFeat" style="direction:rtl"></dd>
          <dt>الحظر</dt><dd id="cBan" style="direction:rtl"></dd>
          <dt>أنشئ</dt><dd id="cCreated" style="direction:rtl"></dd>
          <dt>آخر دخول</dt><dd id="cLast" style="direction:rtl"></dd>
        </dl>
        <div class="acts">
          <button class="ctl danger" id="aBan">حظر مؤقت</button>
          <button class="ctl danger" id="aPerm">حظر دائم</button>
          <button class="ctl good full" id="aUnban">فتح الحظر</button>
          <button class="ctl good" id="aOn">فتح جميع الميزات</button>
          <button class="ctl" id="aOff">غلق جميع الميزات</button>
        </div>
        <div class="banbox" id="banBox">
          <label for="until" style="margin-top:0">حظر حتى (التاريخ والوقت)</label>
          <input id="until" type="datetime-local" style="direction:ltr">
          <div class="quick">
            <button data-h="1">ساعة</button><button data-h="24">يوم</button>
            <button data-h="168">أسبوع</button><button data-h="720">شهر</button>
          </div>
          <button class="btn" id="banGo" style="margin-top:6px">تأكيد الحظر</button>
        </div>
      </div>
    </div>
    <div class="recent" id="recent"></div>
  </section>
</div>
<div class="toast" id="toast"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
let token = localStorage.getItem('ssa_token') || '';
let me = null, poll = null, curAdminId = null;

/* ---------- أدوات ---------- */
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2400)}
function show(id){$$('.screen').forEach(s=>s.classList.toggle('on',s.id===id))}
function shake(el){el.classList.remove('shake');void el.offsetWidth;el.classList.add('shake')}
async function api(path,method='GET',body){
  const h={'Content-Type':'application/json'}; if(token)h.Authorization='Bearer '+token;
  const r=await fetch('/api/'+path,{method,headers:h,body:body?JSON.stringify(body):undefined});
  let j={}; try{j=await r.json()}catch(e){}
  if(!r.ok){const e=new Error(j.error||'خطأ في الاتصال');e.status=r.status;throw e}
  return j;
}
const fmt = t => t ? new Date(t).toLocaleString('ar-EG',{dateStyle:'medium',timeStyle:'short'}) : '—';

/* ---------- 1) البوابة ---------- */
async function doGate(){
  const err=$('#gateErr'); err.textContent='';
  try{
    const j=await api('gate','POST',{code:$('#code').value});
    sessionStorage.setItem('ssa_gate',j.gate); boot();
  }catch(e){err.textContent=e.message;shake($('#s-gate .card'))}
}
$('#gateBtn').onclick=doGate;
$('#code').addEventListener('keydown',e=>{if(e.key==='Enter')doGate()});

/* ---------- 2) الدخول والتسجيل ---------- */
let mode='login';
function setMode(m){
  mode=m;$('#tabLogin').classList.toggle('on',m==='login');$('#tabReg').classList.toggle('on',m==='reg');
  $('#regOnly').style.display=m==='reg'?'block':'none';
  $('#authBtn').textContent=m==='reg'?'إنشاء الحساب':'دخول';
  $('#p').autocomplete=m==='reg'?'new-password':'current-password';$('#authErr').textContent='';
}
$('#tabLogin').onclick=()=>setMode('login');$('#tabReg').onclick=()=>setMode('reg');
async function doAuth(){
  const err=$('#authErr');err.textContent='';
  const username=$('#u').value.trim(),password=$('#p').value;
  if(mode==='reg'&&password!==$('#p2').value){err.textContent='كلمتا المرور غير متطابقتين';return}
  $('#authBtn').disabled=true;
  try{
    const j=await api(mode==='reg'?'register':'login','POST',{username,password,gate:sessionStorage.getItem('ssa_gate')});
    token=j.token;localStorage.setItem('ssa_token',token);localStorage.setItem('ssa_last_user',j.user.username);
    $('#p').value='';$('#p2').value='';route(j.user);startPoll();
  }catch(e){
    if(e.message==='gate'){sessionStorage.removeItem('ssa_gate');boot();return}
    err.textContent=e.message;shake($('#s-auth .card'));
  }finally{$('#authBtn').disabled=false}
}
$('#authBtn').onclick=doAuth;
['u','p','p2'].forEach(i=>$('#'+i).addEventListener('keydown',e=>{if(e.key==='Enter')doAuth()}));

async function logout(){
  try{await api('logout','POST')}catch(e){}
  Engine.stop();stopPoll();token='';localStorage.removeItem('ssa_token');me=null;boot();
}
['#out1','#out2','#out3'].forEach(s=>$(s).onclick=logout);

/* ---------- التوجيه ---------- */
function banActive(u){return u.ban&&(u.ban.permanent||u.ban.until>Date.now())}
function route(u){
  me=u;
  if(u.role==='admin'){Engine.stop();$('#aname').textContent=u.username;if(!$('#s-admin').classList.contains('on')){show('s-admin');loadRecent()}return}
  if(banActive(u)){Engine.stop();renderBan(u);show('s-ban');return}
  $('#uname').textContent=u.username;$('#uid').textContent=u.id;
  applyFeatureLock(u.features);
  if(!$('#s-app').classList.contains('on'))show('s-app');
}
async function boot(){
  stopPoll();
  if(!sessionStorage.getItem('ssa_gate')){show('s-gate');setTimeout(()=>$('#code').focus(),50);return}
  if(token){
    try{const j=await api('me');route(j.user);startPoll();return}
    catch(e){token='';localStorage.removeItem('ssa_token')}
  }
  $('#u').value=localStorage.getItem('ssa_last_user')||'';
  show('s-auth');
}
/* تحديث 
