// SSA server — بدون أي مكتبات خارجية. تشغيل: node server.js  (Node 18+)
const http = require('http');
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const PORT = process.env.PORT || 3000;
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
const DB_FILE = path.join(DATA_DIR, 'db.json');
const GATE_CODE = '19.13.008.2';
const ADMIN_USER = process.env.ADMIN_USER || 'admin';
const ADMIN_PASS = process.env.ADMIN_PASS || 'SSA@admin2026';
const SESSION_MS = 90 * 24 * 3600 * 1000;

fs.mkdirSync(DATA_DIR, { recursive: true });

// ---------- قاعدة البيانات (ملف JSON يُحفظ تلقائياً عند كل تغيير) ----------
let db = { users: {}, sessions: {} };
if (fs.existsSync(DB_FILE)) {
  try { db = JSON.parse(fs.readFileSync(DB_FILE, 'utf8')); }
  catch (e) { console.error('ملف البيانات تالف:', e.message); process.exit(1); }
}
function save() {
  const tmp = DB_FILE + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(db));
  fs.renameSync(tmp, DB_FILE); // كتابة آمنة: لا يتلف الملف لو انقطعت الكهرباء
}

function hashPass(pass, salt) {
  return crypto.scryptSync(pass, salt, 64).toString('hex');
}
function checkPass(pass, u) {
  const a = Buffer.from(hashPass(pass, u.salt), 'hex');
  const b = Buffer.from(u.hash, 'hex');
  return a.length === b.length && crypto.timingSafeEqual(a, b);
}
function newId() {
  const used = new Set(Object.values(db.users).map(u => u.id));
  if (used.size >= 90000) throw new Error('full');
  let id;
  do { id = String(crypto.randomInt(10000, 100000)); } while (used.has(id));
  return id;
}
function makeUser(username, password, role) {
  const salt = crypto.randomBytes(16).toString('hex');
  return {
    id: newId(), username, salt, hash: hashPass(password, salt), role,
    features: true, ban: null, createdAt: Date.now(), lastLogin: null
  };
}

// حساب الإدارة
if (!Object.values(db.users).some(u => u.role === 'admin')) {
  db.users[ADMIN_USER.toLowerCase()] = makeUser(ADMIN_USER, ADMIN_PASS, 'admin');
  save();
  console.log(`تم إنشاء حساب الإدارة: ${ADMIN_USER} / ${ADMIN_PASS}  (غيّر كلمة المرور عبر ADMIN_PASS قبل أول تشغيل)`);
}

// ---------- أدوات ----------
function refreshBan(u) {
  if (u.ban && !u.ban.permanent && u.ban.until <= Date.now()) { u.ban = null; save(); }
}
function view(u, full) {
  refreshBan(u);
  const o = {
    id: u.id, username: u.username, role: u.role, features: u.features !== false,
    ban: u.ban ? { permanent: !!u.ban.permanent, until: u.ban.until || null } : null
  };
  if (full) { o.createdAt = u.createdAt; o.lastLogin = u.lastLogin; }
  return o;
}
function byId(id) { return Object.values(db.users).find(u => u.id === String(id)); }
function authUser(req) {
  const h = req.headers.authorization || '';
  const token = h.startsWith('Bearer ') ? h.slice(7) : '';
  const s = db.sessions[token];
  if (!s) return null;
  if (Date.now() - s.t > SESSION_MS) { delete db.sessions[token]; save(); return null; }
  return db.users[s.u] || null;
}
function newSession(u) {
  const token = crypto.randomBytes(32).toString('hex');
  db.sessions[token] = { u: u.username.toLowerCase(), t: Date.now() };
  save();
  return token;
}
const gates = new Map(); // رموز اجتياز بوابة الرمز
function gateOk(t) { const e = gates.get(t); return !!e && e > Date.now(); }

const hits = new Map(); // تحديد محاولات الدخول
function limited(ip) {
  const now = Date.now();
  let h = hits.get(ip);
  if (!h || h.reset < now) { h = { n: 0, reset: now + 5 * 60 * 1000 }; hits.set(ip, h); }
  return ++h.n > 40;
}

function send(res, code, obj) {
  res.writeHead(code, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
  res.end(JSON.stringify(obj));
}
function readBody(req) {
  return new Promise((ok, no) => {
    let d = '';
    req.on('data', c => { d += c; if (d.length > 20000) { req.destroy(); no(new Error('big')); } });
    req.on('end', () => { try { ok(d ? JSON.parse(d) : {}); } catch (e) { no(e); } });
  });
}

// ---------- المسارات ----------
const server = http.createServer(async (req, res) => {
  try {
    const url = new URL(req.url, 'http://x');
    if (!url.pathname.startsWith('/api/')) {
      const html = fs.readFileSync(path.join(__dirname, 'public', 'index.html'));
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
      return res.end(html);
    }
    const ip = req.socket.remoteAddress;
    const body = req.method === 'POST' ? await readBody(req) : {};
    const route = req.method + ' ' + url.pathname;

    if (route === 'POST /api/gate') {
      if (limited(ip)) return send(res, 429, { error: 'محاولات كثيرة، انتظر قليلاً' });
      if (String(body.code || '').trim() !== GATE_CODE) return send(res, 401, { error: 'الرمز غير صحيح' });
      const g = crypto.randomBytes(16).toString('hex');
      gates.set(g, Date.now() + 24 * 3600 * 1000);
      return send(res, 200, { gate: g });
    }

    if (route === 'POST /api/register' || route === 'POST /api/login') {
      if (limited(ip)) return send(res, 429, { error: 'محاولات كثيرة، انتظر قليلاً' });
      if (!gateOk(body.gate)) return send(res, 403, { error: 'gate' });
      const username = String(body.username || '').trim();
      const password = String(body.password || '');
      const key = username.toLowerCase();

      if (route === 'POST /api/register') {
        if (!/^[\p{L}\p{N}_.-]{3,20}$/u.test(username)) return send(res, 400, { error: 'اسم المستخدم من 3 إلى 20 حرفاً (حروف أو أرقام أو _ . -)' });
        if (password.length < 6 || password.length > 64) return send(res, 400, { error: 'كلمة المرور من 6 إلى 64 حرفاً' });
        if (db.users[key]) return send(res, 409, { error: 'اسم المستخدم مأخوذ' });
        const u = makeUser(username, password, 'user');
        u.lastLogin = Date.now();
        db.users[key] = u;
        const token = newSession(u);
        return send(res, 200, { token, user: view(u, true) });
      }

      const u = db.users[key];
      if (!u || !checkPass(password, u)) return send(res, 401, { error: 'اسم المستخدم أو كلمة المرور غير صحيحة' });
      u.lastLogin = Date.now();
      const token = newSession(u); // يحفظ في db
      return send(res, 200, { token, user: view(u, true) });
    }

    const me = authUser(req);
    if (!me) return send(res, 401, { error: 'auth' });

    if (route === 'GET /api/me') return send(res, 200, { user: view(me, true) });

    if (route === 'POST /api/logout') {
      const t = (req.headers.authorization || '').slice(7);
      delete db.sessions[t]; save();
      return send(res, 200, { ok: true });
    }

    // ----- الإدارة فقط -----
    if (url.pathname.startsWith('/api/admin/')) {
      if (me.role !== 'admin') return send(res, 403, { error: 'غير مسموح' });

      if (route === 'GET /api/admin/user') {
        const u = byId(url.searchParams.get('id'));
        if (!u) return send(res, 404, { error: 'لا يوجد مستخدم بهذا الـ ID' });
        return send(res, 200, { user: view(u, true) });
      }
      if (route === 'GET /api/admin/recent') {
        const list = Object.values(db.users).filter(u => u.role !== 'admin')
          .sort((a, b) => b.createdAt - a.createdAt).slice(0, 15).map(u => view(u, true));
        return send(res, 200, { users: list, total: Object.keys(db.users).length - 1 });
      }
      if (route === 'POST /api/admin/action') {
        const u = byId(body.id);
        if (!u) return send(res, 404, { error: 'لا يوجد مستخدم بهذا الـ ID' });
        if (u.role === 'admin') return send(res, 400, { error: 'لا يمكن تعديل حساب الإدارة' });
        switch (body.action) {
          case 'ban': {
            const until = Number(body.until);
            if (!until || until <= Date.now()) return send(res, 400, { error: 'اختر وقتاً وتاريخاً في المستقبل' });
            u.ban = { permanent: false, until };
            break;
          }
          case 'permban': u.ban = { permanent: true, until: null }; break;
          case 'unban': u.ban = null; break;
          case 'features_on': u.features = true; break;
          case 'features_off': u.features = false; break;
          default: return send(res, 400, { error: 'أمر غير معروف' });
        }
        save(); // حفظ فوري
        return send(res, 200, { user: view(u, true) });
      }
    }

    send(res, 404, { error: 'غير موجود' });
  } catch (e) {
    send(res, 400, { error: 'طلب غير صالح' });
  }
});

server.listen(PORT, () => console.log(`SSA يعمل على http://localhost:${PORT}`));
{
  "name": "ssa-app",
  "version": "1.0.0",
  "private": true,
  "scripts": { "start": "node server.js" },
  "engines": { "node": ">=18" }
}

